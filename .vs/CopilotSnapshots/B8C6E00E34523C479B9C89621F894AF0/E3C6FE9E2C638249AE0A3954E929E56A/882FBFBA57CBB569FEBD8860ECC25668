    <script>
(function () {
    var search = document.getElementById("rhSearch");
    var scoreFilter = document.getElementById("rhScoreFilter");
    var sort = document.getElementById("rhSort");
    var body = document.getElementById("rhTableBody");
    var empty = document.getElementById("rhEmpty");
    var count = document.getElementById("rhVisibleCount");

    if (!search || !scoreFilter || !sort || !body || !empty || !count) {
        return;
    }

    function filterResults() {
        var rows = Array.prototype.slice.call(body.rows);
        var term = search.value.toLowerCase().trim();
        var filter = scoreFilter.value;
        var visibleRows = [];

        rows.forEach(function (row) {
            var title = (row.getAttribute("data-title") || "").toLowerCase();
            var score = Number(row.getAttribute("data-score"));
            var total = Number(row.getAttribute("data-total"));
            var percentage = total > 0 ? score * 100 / total : 0;

            var matchesTitle = title.indexOf(term) !== -1;
            var matchesScore =
                filter === "all" ||
                (filter === "pass" && percentage >= 80) ||
                (filter === "review" && percentage < 80);

            if (matchesTitle && matchesScore) {
                visibleRows.push(row);
            }
        });

        visibleRows.sort(function (a, b) {
            if (sort.value === "highest") {
                return Number(b.getAttribute("data-score")) -
                    Number(a.getAttribute("data-score"));
            }

            if (sort.value === "lowest") {
                return Number(a.getAttribute("data-score")) -
                    Number(b.getAttribute("data-score"));
            }

            var dateA = a.getAttribute("data-date") || "";
            var dateB = b.getAttribute("data-date") || "";

            return sort.value === "oldest"
                ? dateA.localeCompare(dateB)
                : dateB.localeCompare(dateA);
        });

        rows.forEach(function (row) {
            row.style.display = "none";
        });

        visibleRows.forEach(function (row) {
            row.style.display = "";
            body.appendChild(row);
        });

        count.textContent = visibleRows.length;
        empty.style.display = visibleRows.length === 0 ? "block" : "none";
    }

    search.addEventListener("input", filterResults);
    scoreFilter.addEventListener("change", filterResults);
    sort.addEventListener("change", filterResults);
})();
    </script>

